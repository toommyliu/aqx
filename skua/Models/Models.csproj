    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WeaverConfiguration>
      <Weavers>
        <Caseless />
      </Weavers>
    </WeaverConfiguration>
  </PropertyGroup>

  <ItemGroup>
