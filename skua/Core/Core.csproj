<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Skua.Core</AssemblyName>
    <RootNamespace>Skua.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WeaverConfiguration>
      <Weavers>
        <Caseless />
      </Weavers>
    </WeaverConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../vendor/Skua/Skua.Core/Options/Option.cs" />
    <Compile Include="../vendor/Skua/Skua.Core/Scripts/ScriptWait.cs" />
    <Compile Include="../vendor/Skua/Skua.Core/Messaging/ScriptableEventMessages.cs" />
    <Compile Include="../vendor/Skua/Skua.Core/Scripts/ScriptSkill.cs" />
    <Compile Include="../vendor/Skua/Skua.Core/Skills/*.cs" />
    <Compile Include="../vendor/Skua/Skua.Core/Flash/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Caseless.Fody" Version="1.9.1" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Interfaces/Interfaces.csproj" />
  </ItemGroup>

</Project>
